<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Zammarket - Zambia's Online Marketplace</title>
<link rel="stylesheet" href="style.css">
</head>

<body>

<header>
  <h1>Zammarket</h1>
  <p>Buy. Sell. Connect.</p>
</header>

<nav>
  <a href="#home">Home</a>
  <a href="#categories">Categories</a>
  <a href="#products">Products</a>
  <a href="#sell">Sell</a>
</nav>

<section class="hero" id="home">
  <h2>Welcome to Zammarket</h2>
  <p>Zambia's online marketplace for buying and selling products.</p>

  <div class="search">
    <input type="text" placeholder="Search for products...">
    <button>Search</button>
  </div>
</section>

<section class="container" id="categories">
  <h2>Shop by Category</h2>

  <div class="categories">
    <div>👕 Fashion</div>
    <div>📱 Electronics</div>
    <div>💄 Beauty</div>
    <div>🌾 Agriculture</div>
    <div>🛋️ Home</div>
    <div>📚 Education</div>
  </div>
</section>

<section class="container" id="products">
  <h2>Featured Products</h2>

  <div class="products">

    <div class="product">
      <div class="product-image">Product Image</div>
      <h3>Fashion & Clothing</h3>
      <p>Quality clothes from local sellers.</p>
      <strong>From K50</strong>
      <button>View Product</button>
    </div>

    <div class="product">
      <div class="product-image">Product Image</div>
      <h3>Phones & Electronics</h3>
      <p>Phones, computers and accessories.</p>
      <strong>From K200</strong>
      <button>View Product</button>
    </div>

    <div class="product">
      <div class="product-image">Product Image</div>
      <h3>Beauty Products</h3>
      <p>Cosmetics and personal-care products.</p>
      <strong>From K30</strong>
      <button>View Product</button>
    </div>

    <div class="product">
      <div class="product-image">Product Image</div>
      <h3>Agriculture</h3>
      <p>Farm products and agricultural supplies.</p>
      <strong>From K50</strong>
      <button>View Product</button>
    </div>

  </div>
</section>

<section class="sell" id="sell">
  <h2>Have something to sell?</h2>
  <p>Advertise your product on Zammarket and reach potential customers.</p>
  <button>Post a Product</button>
</section>

<footer>
  <h3>Zammarket</h3>
  <p>Buy. Sell. Connect.</p>
  <p>&copy; 2026 Zammarket. All rights reserved.</p>
</footer>

</body>
</html>


